# Environment Variables Template
# Copy this to .env.local and fill in your values

# Supabase Configuration (already in tmp.env)
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=

# Admin User IDs (comma-separated list of user UUIDs)
# Example: VITE_ADMIN_USER_IDS=uuid-1,uuid-2,uuid-3
# Get user ID from: select id from auth.users where email = 'admin@example.com';
VITE_ADMIN_USER_IDS=
